# Plantilla (se sube al repo). Cópiala a:
#   .env             valores locales para `pnpm dev`
#   .env.production  valores de Netlify (Vite también lo usa en `pnpm build`)
# Los dos están en .gitignore. Solo las VITE_* llegan al navegador: nunca pongas secretos.

# Where the app runs in development. Use lvh.me (resolves to 127.0.0.1), not localhost:
# Wompi rejects localhost return URLs, and the session cookie needs the same site as the API.
VITE_APP_URL=http://lvh.me:5173

# API base URL, without a trailing slash. Its CORS_ORIGINS must include VITE_APP_URL.
VITE_API_URL=http://lvh.me:8090

# Show the demo accounts (seeded by the API, synthetic data) on the sign-in screen.
VITE_DEMO_ACCOUNTS=true
